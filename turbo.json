{
	"$schema": "node_modules/turbo/schema.json",
	"ui": "tui",
	"tasks": {
		"dev": {
			"cache": false,
			"persistent": true
		},
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"]
		},
		"deploy": {
			"dependsOn": ["lint", "build"]
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"test": {
			"dependsOn": ["^test", "^build"]
		},
		"test:types": {
			"dependsOn": ["^test:types"]
		}
	}
}
