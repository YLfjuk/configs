{
	"name": "root",
	"version": "0.0.0",
	"private": true,
	"license": "MIT",
	"author": "YLfjuk",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/YLfjuk/configs.git"
	},
	"type": "module",
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"test": "turbo test",
		"test:types": "turbo run test:types",
		"lint": "oxlint .",
		"lint:fix": "oxlint --fix .",
		"fmt": "oxfmt .",
		"fmt:check": "oxfmt --check .",
		"verify": "pnpm fmt:check && pnpm lint && pnpm test:types && pnpm test && pnpm audit && pnpm audit --prod && pnpm pack --dry-run --json --recursive",
		"plan": "changeset",
		"version": "changeset version",
		"prerelease": "pnpm run build",
		"release": "changeset publish"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "0.18.5",
		"@changesets/cli": "^2.29.5",
		"@ylfjuk/md": "*",
		"oxfmt": "0.61.0",
		"oxlint": "1.77.0",
		"publint": "0.3.24",
		"tsdown": "0.22.14",
		"turbo": "^2.10.10",
		"typescript": "7.0.2"
	},
	"engines": {
		"node": ">=24.18.0",
		"pnpm": ">=11.20.0"
	},
	"packageManager": "pnpm@11.20.0"
}
